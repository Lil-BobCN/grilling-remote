# 服务器上的 /etc/afkapp/app.env，权限 600，属主 root。
# systemd 以 root 读这个文件，再把变量交给 afkapp 用户运行的进程。
# 真实值不进仓库。装好后把下面三项填上，再 restart 服务。

PORT=8787

# 读客户仓工单和进度评论用。要能读客户仓；空着就不读 GitHub。
GITHUB_TOKEN=

# 后端没有 SMTP 代码；通知模块的 SMTP 密码走 macOS 钥匙串。这一项留空。
SMTP_PASSWORD=

# 会话签名密钥。用 `openssl rand -base64 32` 生成，换掉会让所有登录态失效。
SESSION_SECRET=

# 数据目录。默认值就是下面两个，部署时一般不用改。
DATA_DIR=/data/customers
UPLOAD_DIR=/data/uploads

# 线上 Cookie 必须带 Secure。
COOKIE_SECURE=true

# 允许的页面来源，逗号分隔。线上两个都要：客户入口 .space，旧域名 .dev 保留兼容。
ALLOWED_ORIGINS=https://afkfactory.space,https://afkfactory.dev
