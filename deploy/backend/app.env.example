# 服务器上的 /etc/afkapp/app.env，权限 600，属主 root。
# systemd 以 root 读这个文件，再把变量交给 afkapp 用户运行的进程。
# 真实值不进仓库。装好后把下面三项填上，再 restart 服务。

PORT=8787

# 读客户仓工单和进度评论用。要能读客户仓；空着就不读 GitHub。
GITHUB_TOKEN=

# 建仓、建单、推需求分支用。fine-grained token 要能创建私有仓、建标签和工单，
# 还要能推模板里的 .github/workflows/ci.yml，所以 Repository permissions 要这四项读写：
# Repository creation、Contents、Issues、Workflows。
# 和上面只读的 GITHUB_TOKEN 分开，别复用同一个。
GITHUB_ADMIN_TOKEN=

# 客户仓建在哪个 GitHub 账号下（用户或组织名）。
GITHUB_OWNER=

# 客户订单页的站点地址；校验未通过邮件里的链接用它。
SITE_BASE=https://afkfactory.space

# 客户邮件 SMTP，backend/bin/customer-mail.py 读这几项。
# 阿里云邮件推送：smtpdm.aliyun.com:465，SSL。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 会话签名密钥。用 `openssl rand -base64 32` 生成，换掉会让所有登录态失效。
SESSION_SECRET=

# 数据目录。默认值就是下面两个，部署时一般不用改。
DATA_DIR=/data/customers
UPLOAD_DIR=/data/uploads

# 线上 Cookie 必须带 Secure。
COOKIE_SECURE=true

# 允许的页面来源，逗号分隔。线上两个都要：客户入口 .space，旧域名 .dev 保留兼容。
ALLOWED_ORIGINS=https://afkfactory.space,https://afkfactory.dev
