# 服务器上的 /etc/caddy/Caddyfile 以这份为准。
# 改完在服务器上跑 sudo caddy validate --config /etc/caddy/Caddyfile，再 sudo systemctl reload caddy。

afkfactory.dev {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		# 只接受 Cloudflare 回源时出示的客户端证书，证书由我们的 AOP CA 签发。
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file /etc/caddy/certs/aop-ca.pem
		}
	}

	root * /data/www

	# 下载链接固定，内容会随重打包变。不加这句，Cloudflare 会把旧 zip 留在边上。
	@downloads path /downloads/*
	header @downloads Cache-Control "no-cache"

	route {
		# 账号区接口反代到本机 Node 服务。服务只管 127.0.0.1，不直接对外。
		@api path /app/api/*
		reverse_proxy @api 127.0.0.1:8787

		# 公开页的干净 URL：/download 出 download.html。
		@public path /download /skills /tutorial /help
		rewrite @public {path}.html

		# 账号区页面都回退到 app/index.html。
		@app path /app /app/*
		handle @app {
			try_files {path} /app/index.html
			file_server
		}

		handle {
			file_server
		}
	}
}

upload.afkfactory.dev {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file /etc/caddy/certs/aop-ca.pem
		}
	}
	respond "ok"
}
