# Sandcastle 只把这里出现过的键转进沙箱，缺一个容器里就没有。
# onboarding 会生成 `.env` 并补齐这些键；这个文件只是键表，不要填真实凭证。
# 凭证二选一：订阅用 CLAUDE_CODE_OAUTH_TOKEN，按量计费用 ANTHROPIC_API_KEY。
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# 用中转时写这两个，模型名也要换成中转支持的名字。
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
CLAUDE_CODE_EFFORT_LEVEL=max
# 容器里的 git 身份。镜像里没配全局身份，这四个键必须写全。
GIT_AUTHOR_NAME=AFK Factory
GIT_AUTHOR_EMAIL=factory@afkfactory.dev
GIT_COMMITTER_NAME=AFK Factory
GIT_COMMITTER_EMAIL=factory@afkfactory.dev
# 读票、写评论、推提交用。onboarding 用 GitHub App 按当前仓换 1 小时 token，
# 只覆盖当前客户仓，权限是 Issues、Pull requests、Contents 读写；
# 不要填宿主已有的宽权限 token。
GH_TOKEN=
# 容器镜像名。不写就用 sandcastle:<仓名>。
SANDCASTLE_IMAGE=
# 容器里跑哪个模型。不写就沿用 ANTHROPIC_MODEL。
SANDCASTLE_MODEL=
