# Sandcastle 只把这里出现过的键转进沙箱，缺一个容器里就没有。
# 凭证二选一：订阅用 CLAUDE_CODE_OAUTH_TOKEN，按量计费用 ANTHROPIC_API_KEY。
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# 用中转时写这两个，模型名也要换成中转支持的名字。
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
# 容器里的默认模型；和下面的 SANDCASTLE_MODEL 二选一。
ANTHROPIC_MODEL=
# 读票、写评论、推提交用。GH_TOKEN 用 fine-grained PAT（细粒度个人访问令牌）：
# 只选当前客户仓，权限只勾 Issues、Pull requests、Contents 读写。
# 不填宿主已有的宽权限 token，容器只认这个文件。
GH_TOKEN=
# 容器镜像名。不写就用 sandcastle:<仓名>。
# 构建：npx @ai-hero/sandcastle docker build-image --image-name <镜像名>
SANDCASTLE_IMAGE=
# 容器里跑哪个模型。不写就沿用 ANTHROPIC_MODEL。
SANDCASTLE_MODEL=
